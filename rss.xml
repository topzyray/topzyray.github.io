---
layout: compress
permalink: /rss.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.lang | xml_escape }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/rss.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% for post in site.posts limit: 5 %}
      {% assign post_url = post.url | absolute_url %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ post_url | xml_escape }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
      {% for category in post.categories %}
      <category>{{ category | xml_escape }}</category>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
